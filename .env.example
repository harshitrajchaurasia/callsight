# Models: one key is enough. CALL_PROVIDER=claude|grok picks the default (claude if its key is set).
ANTHROPIC_API_KEY=
XAI_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5
# XAI_MODEL=grok-4.20-0309-non-reasoning

# PII Shield (github.com/harshitrajchaurasia/pii-shield). Calls stop if it's unreachable.
PII_SHIELD_URL=http://127.0.0.1:18081

# Speech-to-text
# WHISPER_MODEL=small.en
# SECOND_OPINION=0             # turn off the second model on borderline calls
# CHANNEL_SPEAKERS=Account manager,Client

# Monday.com (optional): one item per call. Writes happen only if every board subscriber is in the allowlist.
MONDAY_API_TOKEN=
MONDAY_CALLS_BOARD_ID=
MONDAY_ALLOWED_SUBSCRIBERS=
MONDAY_BOARD_URL=            # optional: https://<account>.monday.com/boards/<id>, so the app can link to items
MONDAY_BOARD_NAME=           # optional: what the app calls that board, e.g. "Client Calls"
MONDAY_TASKS_BOARD_ID=        # optional: tasks from voice commands go here (default: the calls board)

# Go High Level (optional): a note on the client's contact. JSON map of our client id -> GHL contact id.
GHL_API_KEY=
GHL_CONTACTS={}

# Spending guards for a hosted copy (all optional)
# DAILY_BUDGET_USD=1.00
# CALLS_PER_HOUR=10
# ASKS_PER_HOUR=30
# MAX_AUDIO_MINUTES=10

# Optional login (leave DEMO_PASS empty for an open demo or local use)
DEMO_USER=
DEMO_PASS=
# more logins, comma separated: EXTRA_LOGINS=alice:pass1,bob:pass2
EXTRA_LOGINS=
