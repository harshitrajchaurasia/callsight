# Models: one key is enough. CALL_PROVIDER=claude|grok picks the default (claude if its key is set).
ANTHROPIC_API_KEY=
XAI_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5
# XAI_MODEL=grok-4.20-0309-non-reasoning

# PII Shield (github.com/harshitrajchaurasia/pii-shield). Calls stop if it's unreachable.
PII_SHIELD_URL=http://127.0.0.1:18081

# Speech-to-text
# WHISPER_MODEL=small.en
# CHANNEL_SPEAKERS=Account manager,Client

# Monday.com (optional): one item per call. Writes happen only if every board subscriber is in the allowlist.
MONDAY_API_TOKEN=
MONDAY_CALLS_BOARD_ID=
MONDAY_ALLOWED_SUBSCRIBERS=

# Go High Level (optional): a note on the client's contact. JSON map of our client id -> GHL contact id.
GHL_API_KEY=
GHL_CONTACTS={}

# Login for a hosted copy (leave DEMO_PASS empty for local use)
DEMO_USER=
DEMO_PASS=
